#!/bin/sh
#
# Provision and refresh the Flox environment for one service.
#
#   flox-pull <instance> start   -- run before the service, as a dependency
#   flox-pull <instance> timer   -- run on the autopull schedule
#
# Runs as root so it can create the working directory, create the service
# account and restart the unit, but every flox invocation drops privileges to
# the service user.
set -eu

. /usr/libexec/flox/flox-common.sh

name=${1:?usage: flox-pull <instance> (start|timer)}
mode=${2:?usage: flox-pull <instance> (start|timer)}

flox_load_conf "$name"

# Create the service account on first use. sysusers.d cannot do this: it is
# static, and instance names are not known until an operator enables one.
if ! getent group "$flox_group" >/dev/null 2>&1; then
  groupadd --system "$flox_group"
fi
if ! getent passwd "$flox_user" >/dev/null 2>&1; then
  useradd --system --gid "$flox_group" --home-dir "$flox_workdir" \
    --shell /sbin/nologin --comment "Flox service $name" "$flox_user"
fi

mkdir -p "$flox_workdir"
chown "$flox_user:$flox_group" "$flox_workdir"
chmod "${FLOX_WORKDIR_MODE:-0700}" "$flox_workdir"
cd "$flox_workdir"

# Serialize pulls against this working directory: a service-start pull
# (flox-pull@) and a scheduled pull (flox-autopull@) are separate units and
# may otherwise run concurrently, e.g. when a persistent timer fires its
# catch-up run around boot.
exec 9>.flox-pull.lock
flock 9

# Export the token for the flox invocations below. This script runs as root,
# so it reads the operator's file directly rather than needing a credential.
if [ -n "$flox_token_file" ]; then
  [ -r "$flox_token_file" ] || die "token file $flox_token_file is not readable"
  FLOX_FLOXHUB_TOKEN="$(cat "$flox_token_file")"
  export FLOX_FLOXHUB_TOKEN
fi

# Run a command as the service user, preserving the environment (including an
# exported FLOX_FLOXHUB_TOKEN).
as_user() {
  # shellcheck disable=SC2046
  setpriv --reuid "$flox_user" --regid "$flox_group" --init-groups \
    env $(flox_service_env) "$@"
}

# Fingerprint of the local generation history, used to detect whether a pull
# fetched a new generation.
generation_state() {
  as_user "$FLOX_BIN" $FLOX_ARGS generations list --json 2>/dev/null | sha256sum
}

if [ ! -e "$flox_workdir/.flox" ]; then
  # First start: provision the environment. Failure is fatal - there is
  # nothing to run without an environment.
  as_user "$FLOX_BIN" $FLOX_ARGS pull $FLOX_PULL_ARGS "$flox_env"
  exit 0
fi

if [ "$mode" = start ] && [ "$FLOX_PULL_AT_SERVICE_START" != 1 ]; then
  # The environment is provisioned and refresh-on-start is disabled.
  exit 0
fi

before="$(generation_state)" || before=""
if ! as_user "$FLOX_BIN" $FLOX_ARGS pull --force $FLOX_PULL_ARGS; then
  if [ "$mode" = timer ]; then
    echo "ERROR: failed to pull updates for $flox_env." >&2
    exit 1
  fi
  # The environment is already present; a failed refresh must not prevent the
  # service from (re)starting.
  echo "WARNING: failed to pull updates for $flox_env; starting with the existing environment." >&2
  exit 0
fi
after="$(generation_state)" || after=""

if [ "$FLOX_AUTORESTART" = 1 ] && [ "$mode" = timer ] && [ "$before" != "$after" ]; then
  echo "Flox environment $flox_env changed; restarting $flox_unit" >&2
  systemctl try-restart "$flox_unit"
fi

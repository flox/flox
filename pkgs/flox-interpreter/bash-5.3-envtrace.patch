+/* Cheap predicate answering "should a hook site bother capturing the old
+   value and calling envtrace_emit?".  NAME is the variable about to be
+   mutated: the tracer's own control variables always pass the gate (even
+   while tracing is off) so their mutations reach envtrace_emit and can
+   reconfigure the tracer.  Resolves lazy initialization on first use so
+   that, once tracing is determined to be off, every later call is a name
+   check plus a single integer comparison.  Returns 0 before the script body
+   starts. */
+static int
+envtrace_wants (const char *name)
+{
+  if (shell_initialized == 0
+      || subshell_level > 0 || subshell_environment != 0)
+    return 0;
+  if (envtrace_ctlvar (name))
+    return 1;
+  if (envtrace_fd == ENVTRACE_UNINIT)
+    {
+      envtrace_busy = 1;
+      envtrace_init ();
+      envtrace_busy = 0;
+    }
+  return envtrace_active;
+}

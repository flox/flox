+/* Convenience: read the current scalar value of VAR as a C string for the
+   tracer, or NULL if it is unset/invisible or not a plain string (arrays and
+   assoc arrays cannot be exported, so we report them as having no scalar
+   value rather than trying to serialize them here). */
+static const char *
+envtrace_scalar (SHELL_VAR *var)
+{
+  if (var == 0 || invisible_p (var) || var_isset (var) == 0)
+    return (const char *)0;
+#if defined (ARRAY_VARS)
+  if (array_p (var) || assoc_p (var))
+    return (const char *)0;
+#endif
+  return (const char *)value_cell (var);
+}

+  envtrace_busy = 1;
+
+  gettimeofday (&tv, (void *)0);
+
+  size = 128;
+  buf = (char *)xmalloc (size);
+  len = 0;
+
+  n = snprintf (hdr, sizeof (hdr), "%ld.%06ld%c%s%c%d%d%c",
+		(long)tv.tv_sec, (long)tv.tv_usec, ENVTRACE_FS,
+		op, ENVTRACE_FS,
+		oldexp ? 1 : 0, newexp ? 1 : 0, ENVTRACE_FS);
+  if (n < 0)
+    { free (buf); envtrace_busy = 0; return; }
+  envtrace_append_raw (&buf, &len, &size, hdr, (size_t)n);
+
+  envtrace_append_escaped (&buf, &len, &size, name);
+
+  {
+    char fs = ENVTRACE_FS;
+    envtrace_append_raw (&buf, &len, &size, &fs, 1);
+    if (oldval == 0)
+      envtrace_append_raw (&buf, &len, &size, "@", 1);
+    else
+      {
+	envtrace_append_raw (&buf, &len, &size, ":", 1);
+	envtrace_append_escaped (&buf, &len, &size, oldval);
+      }
+    envtrace_append_raw (&buf, &len, &size, &fs, 1);
+    if (newval == 0)
+      envtrace_append_raw (&buf, &len, &size, "@", 1);
+    else
+      {
+	envtrace_append_raw (&buf, &len, &size, ":", 1);
+	envtrace_append_escaped (&buf, &len, &size, newval);
+      }
+    envtrace_append_raw (&buf, &len, &size, "\n", 1);
+  }
+
+  if (to_buffer)
+    envtrace_buf_add (name, buf, len, (size_t)n - 3);	/* buf ownership moves */
+  else
+    {
+      envtrace_write_all (buf, len);
+      free (buf);
+    }
+  FREE (opbuf);
+  envtrace_busy = 0;
+  }
+}

+/* Is NAME one of the tracer's own control variables?  Returns
+   ENVTRACE_SRC_FILE / ENVTRACE_SRC_FD (the sink controls),
+   ENVTRACE_CTL_RESET (the always-reset intent marker), or
+   ENVTRACE_SRC_NONE. */
+static int
+envtrace_ctlvar (const char *name)
+{
+  if (name == 0 || name[0] != 'B' || strncmp (name, "BASH_ENVTRACE_", 14) != 0)
+    return ENVTRACE_SRC_NONE;
+  if (STREQ (name + 14, "FILE"))
+    return ENVTRACE_SRC_FILE;
+  if (STREQ (name + 14, "FD"))
+    return ENVTRACE_SRC_FD;
+  if (STREQ (name + 14, "RESET"))
+    return ENVTRACE_CTL_RESET;
+  return ENVTRACE_SRC_NONE;
+}

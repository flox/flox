+/* Does the script currently declare always-reset intent covering NAME?
+   The marker is BASH_ENVTRACE_RESET, honored in every form the shell can
+   set it:
+     - per-command temporary-environment prefix:
+         BASH_ENVTRACE_RESET=1 export FOO=bar
+     - region toggle (also what a wrapper function uses):
+         BASH_ENVTRACE_RESET=1; ...; BASH_ENVTRACE_RESET=
+     - registry: a whitespace-separated list of shell patterns naming the
+       variables it covers ("1" covers everything):
+         BASH_ENVTRACE_RESET='PATH MANPATH FOO*'
+   Like the other control variables it is never recorded and never
+   exported to child processes. */
+static int
+envtrace_reset_intent (const char *name)
+{
+  SHELL_VAR *var;
+  char *v, *t, *e, *pat;
+  int match;
+
+  var = find_tempenv_variable ("BASH_ENVTRACE_RESET");
+  if (var == 0)
+    var = find_variable ("BASH_ENVTRACE_RESET");
+  if (var == 0)
+    return 0;
+  v = value_cell (var);
+  if (v == 0 || *v == '\0')
+    return 0;
+  if (v[0] == '1' && v[1] == '\0')
+    return 1;
+  match = 0;
+  for (t = v; *t && match == 0; t = e)
+    {
+      while (*t == ' ' || *t == '\t')
+	t++;
+      if (*t == '\0')
+	break;
+      for (e = t; *e && *e != ' ' && *e != '\t'; e++)
+	;
+      pat = (char *)xmalloc ((size_t)(e - t) + 1);
+      memcpy (pat, t, (size_t)(e - t));
+      pat[e - t] = '\0';
+      if (strmatch (pat, (char *)name, FNMATCH_EXTFLAG) == 0)
+	match = 1;
+      free (pat);
+    }
+  return match;
+}

+/* Public entry point for other translation units (e.g. builtins/setattr.def)
+   to record a change to a variable's export attribute: `export NAME' /
+   `export -n NAME'.  UNDO is nonzero when the attribute is being removed.
+   OLDEXP is the attribute state BEFORE the change (captured by the caller,
+   since the change has already been applied by the time this runs).
+   The attribute change is reported as the environment mutation it amounts
+   to: `export NAME' on a variable with a value that was not previously a
+   member is the moment its (possibly built-up) value enters the
+   environment, reported as a `set'; `export -n' on a member is an `unset'.
+   Attribute churn with no environment effect (redundant re-export,
+   unexport of a non-member, placeholders with no value) reports nothing. */
+void
+bash_envtrace_export_change (SHELL_VAR *var, int undo, int oldexp)
+{
+  const char *v;
+
+  /* Attribute changes on the tracer's own control variables mean nothing
+     here (they are never environment members), and must not be mistaken
+     for the real assignment/unset operations that reconfigure the sink. */
+  if (var == 0 || envtrace_ctlvar (name_cell (var))
+      || envtrace_wants (name_cell (var)) == 0)
+    return;
+  v = envtrace_scalar (var);
+  if (v == 0)
+    return;
+  if (undo == 0 && oldexp == 0)
+    envtrace_emit ("set", name_cell (var), (const char *)0, v, 0, 1);
+  else if (undo && oldexp)
+    envtrace_emit ("unset", name_cell (var), v, (const char *)0, 1, 0);
+}

+#include <sys/time.h>
+#include <errno.h>
+#include <limits.h>
+#include <glob/strmatch.h>	/* strmatch for the reset-intent registry */
+
+#define ENVTRACE_FS	'\037'		/* unit separator, field delimiter */
+#define ENVTRACE_UNINIT	(-2)
+#define ENVTRACE_OFF	(-1)
+
+#define ENVTRACE_SRC_NONE 0
+#define ENVTRACE_SRC_FILE 1
+#define ENVTRACE_SRC_FD   2
+#define ENVTRACE_CTL_RESET 3	/* intent marker, never a sink */
+
+static int envtrace_fd = ENVTRACE_UNINIT;
+static int envtrace_owned = 0;		/* did we open envtrace_fd ourselves? */
+static int envtrace_active = 0;		/* nonzero once fd is usable */
+static int envtrace_busy = 0;		/* re-entrancy guard */
+static int envtrace_source = ENVTRACE_SRC_NONE;	/* which control var configured the sink */
+static pid_t envtrace_owner = 0;	/* pid that configured the sink; sole writer */

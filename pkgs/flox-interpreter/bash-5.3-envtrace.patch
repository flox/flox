+/* Emit one record.  OP is the operation name; NAME the variable; OLDVAL and
+   NEWVAL are the values before and after (NULL meaning "did not exist");
+   OLDEXP and NEWEXP are the pre- and post-operation export states. */
+static void
+envtrace_emit (const char *op, const char *name,
+	       const char *oldval, const char *newval, int oldexp, int newexp)
+{
+  char *buf;
+  size_t len, size;
+  char hdr[128];
+  int n, ctl, to_buffer;
+  struct timeval tv;

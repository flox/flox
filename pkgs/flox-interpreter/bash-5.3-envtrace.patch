+/* Tear down the current sink, closing the descriptor if we opened it. */
+static void envtrace_buf_drop_all (void);
+
+static void
+envtrace_disable (void)
+{
+  if (envtrace_owned && envtrace_fd >= 0)
+    close (envtrace_fd);
+  envtrace_fd = ENVTRACE_OFF;
+  envtrace_owned = 0;
+  envtrace_active = 0;
+  envtrace_source = ENVTRACE_SRC_NONE;
+  envtrace_buf_drop_all ();	/* unflushed history dies with its window */
+}
+
+/* (Re)configure the sink from a control-variable value.  CTL says which
+   variable was assigned; VALUE is its just-assigned value.  The assignment
+   always replaces the current sink; an empty or unusable value leaves the
+   tracer disabled. */
+static void
+envtrace_control_set (int ctl, const char *value)
+{
+  char *ep;
+  long fdnum;
+  int fd;
+
+  envtrace_disable ();			/* most recent assignment wins */
+
+  if (value == 0 || *value == '\0')
+    return;
+
+  if (ctl == ENVTRACE_SRC_FD)
+    {
+      errno = 0;
+      fdnum = strtol (value, &ep, 10);
+      if (errno == 0 && ep != value && *ep == '\0'
+	  && fdnum >= 0 && fdnum <= INT_MAX
+	  && fcntl ((int)fdnum, F_GETFD) != -1)	/* fd must actually be open */
+	{
+	  envtrace_fd = (int)fdnum;
+	  envtrace_owned = 0;
+	  envtrace_active = 1;
+	  envtrace_source = ENVTRACE_SRC_FD;
+	  envtrace_owner = getpid ();
+	}
+      return;
+    }
+
+  fd = open (value, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0600);
+  if (fd >= 0)
+    {
+      envtrace_fd = fd;
+      envtrace_owned = 1;
+      envtrace_active = 1;
+      envtrace_source = ENVTRACE_SRC_FILE;
+      envtrace_owner = getpid ();
+    }
+}
+
+/* Startup activation.  Reads the shell's own variable table (not the
+   process environment), so the control variables work whether or not they
+   are exported; variables inherited from the environment are in the table
+   too, so `BASH_ENVTRACE_FILE=x bash script' still activates as before. */
+static void
+envtrace_init (void)
+{
+  char *s;
+
+  envtrace_fd = ENVTRACE_OFF;		/* default: disabled */
+
+  s = get_string_value ("BASH_ENVTRACE_FD");
+  if (s && *s)
+    {
+      envtrace_control_set (ENVTRACE_SRC_FD, s);
+      return;				/* explicit FD requested; FD wins */
+    }
+
+  s = get_string_value ("BASH_ENVTRACE_FILE");
+  if (s && *s)
+    envtrace_control_set (ENVTRACE_SRC_FILE, s);
+}
+
+static void envtrace_emit (const char *, const char *, const char *, const char *, int, int);
+static const char *envtrace_scalar (SHELL_VAR *);
+static int envtrace_wants (const char *);
+
+/* ---- function-scope teardown ------------------------------------------ */
+/* Locals are disposed wholesale when a function returns, without passing
+   through makunbound, so exported locals (`local -x') would vanish from
+   the environment without a record.  pop_var_context snapshots the dying
+   context's environment members with these helpers and, after the pop,
+   reconciles each against whatever the name resolves to in the enclosing
+   scope: nothing if an outer member holds the same value (covers vars
+   propagated down), a value-change record if an outer member differs
+   (an exported local shadowing an exported outer variable), or `unset'
+   if the name is no longer a member. */
+
+static int
+envtrace_collect_members (HASH_TABLE *table, char ***namesp, char ***valsp)
+{
+  register int i;
+  BUCKET_CONTENTS *elt;
+  SHELL_VAR *var;
+  const char *v;
+  char **names, **vals;
+  int n;
+
+  names = strvec_create (table->nentries + 1);
+  vals = strvec_create (table->nentries + 1);
+  n = 0;
+  for (i = 0; i < table->nbuckets; i++)
+    for (elt = hash_items (i, table); elt; elt = elt->next)
+      {
+	var = (SHELL_VAR *)elt->data;
+	v = envtrace_scalar (var);
+	if (v && exported_p (var))
+	  {
+	    names[n] = savestring (name_cell (var));
+	    vals[n] = savestring (v);
+	    n++;
+	  }
+      }
+  names[n] = vals[n] = 0;
+  *namesp = names;
+  *valsp = vals;
+  return n;
+}
+
+static void
+envtrace_scope_pop_emit (int n, char **names, char **vals)
+{
+  SHELL_VAR *var;
+  const char *v;
+  int i;
+
+  for (i = 0; i < n; i++)
+    {
+      var = find_variable (names[i]);
+      v = var ? envtrace_scalar (var) : (const char *)0;
+      if (v && exported_p (var))
+	{
+	  if (STREQ (v, vals[i]) == 0)
+	    envtrace_emit ("set", names[i], vals[i], v, 1, 1);
+	}
+      else
+	envtrace_emit ("unset", names[i], vals[i], (const char *)0, 1, 0);
+    }
+  strvec_dispose (names);
+  strvec_dispose (vals);
+}
+
+/* Write one complete record with a single write() call so a crash
+   mid-record cannot tear the stream.  Retry on EINTR and short writes;
+   give up silently on other errors. */
+static void
+envtrace_write_all (const char *data, size_t len)
+{
+  size_t off = 0;
+
+  while (off < len)
+    {
+      ssize_t w = write (envtrace_fd, data + off, len - off);
+      if (w < 0)
+	{
+	  if (errno == EINTR)
+	    continue;
+	  break;
+	}
+      off += (size_t)w;
+    }
+}
+
+/* ---- deferred reporting for not-yet-exported variables ---------------- */
+/* Mutations of variables that are not environment members are formatted
+   but BUFFERED, per variable, rather than written: if the variable is
+   later exported, its accumulated history is flushed to the trace (so the
+   exact sequence of operations -- and their deltas -- is preserved, with
+   the timestamps of when they actually happened); if it is unset first,
+   or never exported, the history is discarded.  On flush the first
+   record's pre-digit is patched to 0 -- that is the moment the entry
+   appeared in the environment -- and the rest to 1, keeping the stream
+   invertible. */
+
+typedef struct envtrace_brec
+{
+  struct envtrace_brec *next;
+  char *line;			/* complete formatted record, incl. newline */
+  size_t len;
+  size_t exp_off;		/* offset of the pre-digit within line */
+} ENVTRACE_BREC;
+
+typedef struct envtrace_bvar
+{
+  struct envtrace_bvar *next;
+  char *name;
+  ENVTRACE_BREC *head, *tail;
+} ENVTRACE_BVAR;
+
+static ENVTRACE_BVAR *envtrace_buffers = 0;
+
+static ENVTRACE_BVAR *
+envtrace_buf_find (const char *name)
+{
+  ENVTRACE_BVAR *b;
+
+  for (b = envtrace_buffers; b; b = b->next)
+    if (STREQ (b->name, name))
+      return b;
+  return 0;
+}
+
+/* Take ownership of LINE and queue it as NAME's next buffered record. */
+static void
+envtrace_buf_add (const char *name, char *line, size_t len, size_t exp_off)
+{
+  ENVTRACE_BVAR *b;
+  ENVTRACE_BREC *r;
+
+  b = envtrace_buf_find (name);
+  if (b == 0)
+    {
+      b = (ENVTRACE_BVAR *)xmalloc (sizeof (ENVTRACE_BVAR));
+      b->name = savestring (name);
+      b->head = b->tail = 0;
+      b->next = envtrace_buffers;
+      envtrace_buffers = b;
+    }
+  r = (ENVTRACE_BREC *)xmalloc (sizeof (ENVTRACE_BREC));
+  r->line = line;
+  r->len = len;
+  r->exp_off = exp_off;
+  r->next = 0;
+  if (b->tail)
+    b->tail->next = r;
+  else
+    b->head = r;
+  b->tail = r;
+}
+
+static void
+envtrace_buf_free (ENVTRACE_BVAR *b)
+{
+  ENVTRACE_BVAR **pp;
+  ENVTRACE_BREC *r, *rn;
+
+  for (pp = &envtrace_buffers; *pp; pp = &(*pp)->next)
+    if (*pp == b)
+      {
+	*pp = b->next;
+	break;
+      }
+  for (r = b->head; r; r = rn)
+    {
+      rn = r->next;
+      free (r->line);
+      free (r);
+    }
+  free (b->name);
+  free (b);
+}
+
+/* Discard NAME's buffered history (it was unset before being exported). */
+static void
+envtrace_buf_drop (const char *name)
+{
+  ENVTRACE_BVAR *b;
+
+  b = envtrace_buf_find (name);
+  if (b)
+    envtrace_buf_free (b);
+}
+
+/* Discard everything (the sink is going away). */
+static void
+envtrace_buf_drop_all (void)
+{
+  while (envtrace_buffers)
+    envtrace_buf_free (envtrace_buffers);
+}
+
+static void envtrace_write_all (const char *, size_t);
+
+/* NAME is becoming an environment member: write its buffered history,
+   patching the membership digits (first record 01, the rest 11).
+   Returns nonzero if any records were flushed. */
+static int
+envtrace_buf_flush (const char *name)
+{
+  ENVTRACE_BVAR *b;
+  ENVTRACE_BREC *r;
+  int first, flushed;
+
+  b = envtrace_buf_find (name);
+  if (b == 0)
+    return 0;
+  flushed = 0;
+  for (r = b->head, first = 1; r; r = r->next, first = 0)
+    {
+      r->line[r->exp_off] = first ? '0' : '1';
+      r->line[r->exp_off + 1] = '1';
+      envtrace_write_all (r->line, r->len);
+      flushed = 1;
+    }
+  envtrace_buf_free (b);
+  return flushed;
+}
+
+/* Append the escaped form of the NUL-terminated string S to *BUFP, growing
+   the buffer as needed.  *LENP is the current length, *SIZEP the capacity. */
+static void
+envtrace_append_escaped (char **bufp, size_t *lenp, size_t *sizep, const char *s)
+{
+  const unsigned char *p;
+  char *buf;
+  size_t len, size;
+  static const char hexdigits[] = "0123456789abcdef";
+
+  buf = *bufp; len = *lenp; size = *sizep;
+  for (p = (const unsigned char *)s; p && *p; p++)
+    {
+      /* Worst case a single input byte expands to 4 output bytes (\xHH). */
+      if (len + 5 > size)
+	{
+	  size = (size * 2) + 32;
+	  buf = (char *)xrealloc (buf, size);
+	}
+      switch (*p)
+	{
+	case '\\':	buf[len++] = '\\'; buf[len++] = '\\'; break;
+	case '\n':	buf[len++] = '\\'; buf[len++] = 'n'; break;
+	case '\r':	buf[len++] = '\\'; buf[len++] = 'r'; break;
+	default:
+	  if (*p < 0x20 || *p == (unsigned char)ENVTRACE_FS)
+	    {
+	      buf[len++] = '\\';
+	      buf[len++] = 'x';
+	      buf[len++] = hexdigits[(*p >> 4) & 0xf];
+	      buf[len++] = hexdigits[*p & 0xf];
+	    }
+	  else
+	    buf[len++] = (char)*p;
+	  break;
+	}
+    }
+  *bufp = buf; *lenp = len; *sizep = size;
+}
+
+static void
+envtrace_append_raw (char **bufp, size_t *lenp, size_t *sizep, const char *s, size_t n)
+{
+  if (*lenp + n > *sizep)
+    {
+      *sizep = (*lenp + n) * 2 + 32;
+      *bufp = (char *)xrealloc (*bufp, *sizep);
+    }
+  memcpy (*bufp + *lenp, s, n);
+  *lenp += n;
+}
+
+/* Refine a generic value-assignment into the precise mutation kind, from
+   the old/new value pair alone.  See the op table in the banner comment.
+   The containment checks are exact byte comparisons; anything that is not
+   pure growth at one end reports as "updated". */
+static const char *
+envtrace_classify_set (const char *oldval, const char *newval)
+{
+  size_t ol, nl;
+
+  if (oldval == 0)
+    return "set";		/* did not exist before */
+  if (newval == 0)
+    return "updated";		/* value disappeared without an unset */
+  if (STREQ (oldval, newval))
+    return "reset";
+  ol = strlen (oldval);
+  nl = strlen (newval);
+  if (nl > ol && memcmp (newval, oldval, ol) == 0)
+    return "append";		/* old is a prefix: text added at the end */
+  if (nl > ol && memcmp (newval + (nl - ol), oldval, ol) == 0)
+    return "prepend";		/* old is a suffix: text added at the front */
+  return "updated";

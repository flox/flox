+  /* Inert until the shell is running the script/-c body, and never
+     re-enter (nothing we call binds variables, but be defensive).  Forked
+     subshells -- ( ... ), $(...), async commands, process substitution --
+     inherit this state but must not write: their mutations cannot reach
+     this shell's environment, and a second writer would interleave with
+     the owner.  bash's subshell globals cover every fork path. */
+  if (shell_initialized == 0 || envtrace_busy
+      || subshell_level > 0 || subshell_environment != 0)
+    return;
+
+  /* A `set' that neither had a prior value nor produced one is an invisible
+     placeholder (e.g. `declare -x NAME' with no value): it is not yet an
+     environment entry and carries no value delta, so drop it as noise.  Its
+     eventual value assignment and any export-attribute change are traced
+     separately. */
+  if (oldval == 0 && newval == 0 && op[0] == 's' && op[1] == 'e' && op[2] == 't' && op[3] == '\0')
+    return;
+
+  /* Mutating a control variable reconfigures the tracer.  Assignment is
+     applied *before* emitting so the record below lands in the sink it just
+     configured; removal is applied after (see the bottom of this function).
+     A `tempenv' overlay of a control variable is a child-only value and does
+     not reconfigure this shell's tracer. */
+  ctl = envtrace_ctlvar (name);
+  if ((ctl == ENVTRACE_SRC_FILE || ctl == ENVTRACE_SRC_FD)
+      && STREQ (op, "set"))
+    {
+      envtrace_busy = 1;
+      envtrace_control_set (ctl, newval);
+      envtrace_busy = 0;
+    }
+  else if (envtrace_fd == ENVTRACE_UNINIT)
+    {
+      envtrace_busy = 1;
+      envtrace_init ();
+      envtrace_busy = 0;
+    }
+  if (envtrace_active == 0)
+    return;
+
+  /* Belt and braces for any fork the globals above might not describe:
+     only the process that configured the sink ever writes to it. */
+  if (envtrace_owner != getpid ())
+    return;
+
+  /* The exported digits report actual environment MEMBERSHIP, not just
+     the export attribute: a variable carrying the attribute but no value
+     (an invisible `declare -x NAME' placeholder) has no environ entry, so
+     it is not a member.  This also makes the visibility filter below drop
+     placeholder-only attribute churn. */
+  oldexp = oldexp && oldval != 0;
+  newexp = newexp && newval != 0;
+
+  /* The tracer's own control variables are never recorded: they are
+     excluded from child environments by construction, so no mutation of
+     theirs is ever environment-visible.  Removing the control variable
+     that owns the active sink still stops tracing; it just writes no
+     record of its own. */
+  if (ctl != ENVTRACE_SRC_NONE)
+    {
+      if (ctl == envtrace_source && STREQ (op, "unset"))
+	envtrace_disable ();
+      return;
+    }
+
+  /* Mutations of variables that are environment members neither before
+     nor after the operation are BUFFERED, not written: their history is
+     reported only if the variable is later exported (see the flush below),
+     and discarded if it is unset first.  `00' never appears in a stream. */
+  to_buffer = 0;
+  if (oldexp == 0 && newexp == 0)
+    {
+      if (STREQ (op, "unset"))
+	{
+	  envtrace_buf_drop (name);
+	  return;
+	}
+      to_buffer = 1;
+    }
+  else if (oldexp == 0 && newexp != 0)
+    {
+      /* The variable is becoming an environment member.  If it carries
+	 buffered history, flush that first: it reports exactly how the
+	 value was built up, and its first record is the moment the entry
+	 appeared.  A bare `export NAME' (reported by the caller as a
+	 synthetic `set' with no old value) is then fully told by the
+	 history and writes nothing further; an assignment that itself
+	 makes the variable a member continues below as a member op. */
+      if (envtrace_buf_flush (name))
+	{
+	  if (oldval == 0 && op[0] == 's' && STREQ (op, "set"))
+	    return;
+	  oldexp = 1;
+	}
+    }
+
+  /* The hook sites report every value assignment as a generic "set"; refine
+     it here, where old and new are both in hand.  (The control-variable
+     logic above still keys on the generic op names.) */
+  if (op[0] == 's' && op[1] == 'e' && op[2] == 't' && op[3] == '\0')
+    op = envtrace_classify_set (oldval, newval);
+
+  /* A same-value assignment is ambiguous: it may mean "default this
+     variable" or "always force this value".  Without declared intent it
+     reports as `set-if-absent' (a replayer keeps its own value); with
+     BASH_ENVTRACE_RESET intent covering the name it reports as `reset'
+     (a replayer overwrites).  Intent is evaluated now, at mutation time,
+     so buffered histories carry the intent in force when they happened. */
+  if (op[0] == 'r' && STREQ (op, "reset") && envtrace_reset_intent (name) == 0)
+    op = "set-if-absent";
+
+  /* Reduce the new value to the op's operand: prepend/append record only
+     the added text, everything else the full value (NULL for unset). */
+  {
+    const char *operand;
+    char *opbuf = 0;
+
+    if (op[0] == 'a' && STREQ (op, "append"))
+      operand = newval + strlen (oldval ? oldval : "");
+    else if (op[0] == 'p' && STREQ (op, "prepend"))
+      {
+	size_t plen = strlen (newval) - strlen (oldval ? oldval : "");
+	opbuf = (char *)xmalloc (plen + 1);
+	memcpy (opbuf, newval, plen);
+	opbuf[plen] = '\0';
+	operand = opbuf;
+      }
+    else
+      operand = newval;
+    newval = operand;
+    /* opbuf freed below, after the record is written */

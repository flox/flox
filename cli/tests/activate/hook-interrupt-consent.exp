# Activate a project environment using --dir, then cd into a second,
# unregistered directory and press Ctrl+C at the auto-activation consent
# prompt the hook raises (default `auto_activate = "prompt"`). `hook-env` is
# blocked on the prompt reading the terminal, so the interrupt arrives while
# `hook-env` itself is running. The third argument is a command run afterwards
# to observe whether the environment activated and whether it was suppressed.

set dir [lindex $argv 0]
set target [lindex $argv 1]
set command [lindex $argv 2]
set flox $env(FLOX_BIN)
# Auto-activation may lock and build an environment on first use.
set timeout 60
set env(NO_COLOR) 1
set env(TERM) xterm-mono
set stty_init "cols 1000"

spawn $flox activate --dir $dir
expect_after {
  timeout { exit 1 }
  eof { exit 2 }
  "*\n" { exp_continue }
  "*\r" { exp_continue }
}

expect "You are now using the environment"
expect $env(KNOWN_PROMPT)

send "cd $target\n"
# The prompt hook runs before the next prompt and asks for consent on the tty.
expect "y/N"
sleep 0.5
send "\x03"
# The interrupt must dismiss the question and return to the prompt without
# asking again. Failure modes: a second consent prompt means the hook re-fired
# and re-prompted (exit 3); a timeout means hook-env swallowed the interrupt
# and kept blocking on the tty read. The environment build already happened
# before the first consent prompt, so a short timeout suffices here.
set timeout 15
expect {
  "y/N" { exit 3 }
  $env(KNOWN_PROMPT) { }
}

# Let one more prompt fire to verify the suppression sticks: with the
# environment suppressed the hook must not ask for consent again.
send "true\n"
expect {
  "y/N" { exit 3 }
  $env(KNOWN_PROMPT) { }
}
set timeout 60

send "$command && exit\n"
expect eof
